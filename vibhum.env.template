# ==========================================
# VIBHUM VOICE AI - PRODUCTION ENV TEMPLATE
# ==========================================

# 1. Deployment Environment
ENVIRONMENT=production

# 2. Networking & Domain
# The IP address of the server
SERVER_IP=
# The domain name for the Vibhum platform (e.g., voice.vibhum.com)
PUBLIC_HOST=
# The base URL (e.g., https://voice.vibhum.com)
PUBLIC_BASE_URL=https://${PUBLIC_HOST}

# 3. TURN Server (WebRTC)
ENABLE_COTURN=true
# Secret for TURN authentication (generate a strong random string)
TURN_SECRET=

# 4. Authentication Secrets
# JWT Secret for authenticating UI sessions (generate a strong 32+ char random string)
OSS_JWT_SECRET=

# 5. Database & Storage Credentials
# Postgres password
POSTGRES_PASSWORD=
# Redis password
REDIS_PASSWORD=
# MinIO (S3 compatible storage) credentials
MINIO_ROOT_USER=vibhum_admin
MINIO_ROOT_PASSWORD=

# 6. Performance & Monitoring
# Number of uvicorn workers (recommended: CPU cores * 2)
FASTAPI_WORKERS=4
ENABLE_TELEMETRY=true
